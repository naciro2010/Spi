{
  "realm": "goldcar",
  "enabled": true,
  "displayName": "Goldcar",
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "sslRequired": "none",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "loginTheme": "goldcar",
  "emailTheme": "goldcar",
  "internationalizationEnabled": true,
  "supportedLocales": ["en", "es", "fr"],
  "defaultLocale": "en",
  "smtpServer": {
    "host": "${SMTP_HOST:mailhog}",
    "port": "${SMTP_PORT:1025}",
    "from": "${SMTP_FROM:noreply@goldcar.com}",
    "fromDisplayName": "Goldcar",
    "ssl": "${SMTP_SSL:false}",
    "starttls": "${SMTP_STARTTLS:false}",
    "auth": "${SMTP_AUTH:false}",
    "user": "${SMTP_USER:}",
    "password": "${SMTP_PASSWORD:}"
  },
  "components": {
    "org.keycloak.storage.UserStorageProvider": [
      {
        "name": "goldcar-user-storage",
        "providerId": "goldcar-user-storage",
        "config": {
          "jdbc-url": ["${KC_DB_URL:jdbc:postgresql://goldcar-db:5432/goldcar_legacy}"],
          "db-user": ["${KC_DB_USERNAME:goldcar}"],
          "db-password": ["${KC_DB_PASSWORD:goldcar}"],
          "priority": ["0"],
          "enabled": ["true"],
          "cachePolicy": ["DEFAULT"]
        }
      }
    ]
  },
  "clients": [
    {
      "clientId": "gcapp-ios",
      "name": "Goldcar iOS App",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "redirectUris": [
        "gcapp://callback",
        "http://localhost:8080/*",
        "https://*.up.railway.app/*"
      ],
      "webOrigins": ["*"],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "goldcar-customer-id",
          "protocol": "openid-connect",
          "protocolMapper": "goldcar-customer-id-mapper",
          "consentRequired": false,
          "config": {
            "include.in.access.token": "true",
            "include.in.id.token": "false",
            "include.in.userinfo": "false",
            "claim.name": "goldcar_customer_id",
            "jsonType.label": "String"
          }
        }
      ]
    }
  ],
  "identityProviders": [
    {
      "alias": "google",
      "displayName": "Google",
      "providerId": "google",
      "enabled": true,
      "trustEmail": true,
      "storeToken": false,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "clientId": "${GOOGLE_CLIENT_ID:REPLACE_WITH_GOOGLE_CLIENT_ID}",
        "clientSecret": "${GOOGLE_CLIENT_SECRET:REPLACE_WITH_GOOGLE_CLIENT_SECRET}",
        "defaultScope": "openid email profile",
        "syncMode": "IMPORT"
      }
    }
  ]
}
